rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && 
      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['student', 'admin'] &&
             data.userId == request.auth.uid;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['title', 'category']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category in ['HSC', 'Admission'];
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'subject', 'type']) &&
             data.title is string && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.type in ['Note', 'Sheet', 'Tricks'];
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['text', 'authorId']) &&
             data.text is string && data.text.size() <= 2000 &&
             data.authorId == request.auth.uid;
    }

    function isValidAnswer(data) {
      return data.keys().hasAll(['text', 'authorId']) &&
             data.text is string && data.text.size() <= 2000 &&
             data.authorId == request.auth.uid;
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidUser(incoming()) && userId == request.auth.uid;
      allow update: if isVerifiedUser() && (isOwner(userId) || isAdmin()) && 
                    (isOwner(userId) ? (incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'enrolledCourses', 'lastLoginAt'])) : true);
    }

    match /courses/{courseId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /notes/{noteId} {
      allow read: if isSignedIn(); 
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isVerifiedUser() && isValidQuestion(incoming());
      allow update: if isVerifiedUser() && (isOwner(existing().authorId) || isAdmin()) &&
                   (incoming().diff(existing()).affectedKeys().hasAny(['resolved', 'upvotes', 'text']));
      allow delete: if isAdmin();

      match /answers/{answerId} {
        allow read: if isSignedIn();
        allow create: if isVerifiedUser() && isValidAnswer(incoming());
        allow update: if isVerifiedUser() && (isOwner(existing().authorId) || isAdmin());
        allow delete: if isAdmin();
      }
    }
  }
}
